# For Node hosting; use an absolute database path on persistent storage in production.
SQLITE_PATH=.data/app.sqlite
# Production must be the exact HTTPS website origin, without a path.
AUTH_ORIGIN=http://127.0.0.1:8080
# Server-side Google OAuth web client. Never prefix these with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Newsletter delivery secrets. Both a credential and audience ID are required before selection.
KIT_API_KEY=
KIT_TAG_ID=
SENDER_API_TOKEN=
SENDER_GROUP_ID=
NEWSLETTER_FROM_EMAIL=info@acehou.org
NEWSLETTER_FROM_NAME="Anglican Church of the Epiphany, Houston"

# Giving defaults for local review. The Admin > Giving screen can save database overrides.
# Leave a method disabled until its identifier and verified recipient name are approved.
GIVING_PUBLIC_NAME="Anglican Church of the Epiphany, Houston"
GIVING_LEGAL_NAME=""
GIVING_TAX_STATUS_TEXT=""
GIVING_PUBLIC_EIN=""
GIVING_SUPPORT_EMAIL=""
GIVING_SUPPORT_PHONE=""
GIVING_RECEIPT_TURNAROUND=""
GIVING_TRUST_STATEMENT="This website does not collect payment details. Complete your gift in your bank or payment app and confirm the recipient before sending."
GIVING_OFFLINE_INSTRUCTIONS=""
GIVING_ANNUAL_REPORT_URL=""
GIVING_SOCIAL_IMAGE_PATH=""
GIVING_PRIVACY_TEXT=""
GIVING_RECEIPT_CONSENT_TEXT=""
GIVING_RETENTION_TEXT=""
GIVING_RECEIPTS_ENABLED="false"
GIVING_SIMULATION_MODE="false"

GIVING_ZELLE_ENABLED="false"
GIVING_ZELLE_ID=""
GIVING_ZELLE_RECIPIENT_NAME=""
GIVING_ZELLE_INSTRUCTIONS=""
GIVING_ZELLE_MEMO_GUIDANCE=""
GIVING_ZELLE_QR_PATH=""

GIVING_CASHAPP_ENABLED="false"
GIVING_CASHAPP_CASHTAG=""
GIVING_CASHAPP_RECIPIENT_NAME=""
GIVING_CASHAPP_INSTRUCTIONS=""
GIVING_CASHAPP_MEMO_GUIDANCE=""
GIVING_CASHAPP_URL=""
GIVING_CASHAPP_QR_PATH=""

# Pipe-delimited labels, for example: General Fund|Missions|Youth Ministry
GIVING_DESIGNATIONS=""
# Impact statements remain hidden unless amount, text, evidence and an ISO review timestamp are supplied.
GIVING_IMPACT_1_AMOUNT=""
GIVING_IMPACT_1_TEXT=""
GIVING_IMPACT_1_EVIDENCE=""
GIVING_IMPACT_1_REVIEWED_AT=""
GIVING_IMPACT_2_AMOUNT=""
GIVING_IMPACT_2_TEXT=""
GIVING_IMPACT_2_EVIDENCE=""
GIVING_IMPACT_2_REVIEWED_AT=""
GIVING_IMPACT_3_AMOUNT=""
GIVING_IMPACT_3_TEXT=""
GIVING_IMPACT_3_EVIDENCE=""
GIVING_IMPACT_3_REVIEWED_AT=""
